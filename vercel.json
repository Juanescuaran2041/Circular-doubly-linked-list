{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "outputDirectory": "web",
  "rewrites": [
    { "source": "/api/:route", "destination": "/api?route=:route" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 10,
      "excludeFiles": "{tests/**,web/**,**/__pycache__/**,README.md}"
    }
  }
}
